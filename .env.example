LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM=office

# ROMs you have the right to host. Nothing commercial is in git.
GAMES_ROM_DIR=data/roms

# Browser-facing EmulatorJS Netplay (Socket.IO). Empty = http://<hostname>:3000
NETPLAY_PUBLIC_URL=

# Optional TURN. Default is Google STUN only.
# NETPLAY_ICE_JSON=[{"urls":"stun:stun.l.google.com:19302"}]

# EmulatorJS data CDN. Use latest (tracks main). There is no /main/ path on the CDN.
EJS_CDN=https://cdn.emulatorjs.org/latest/data/
