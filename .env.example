# Meeting Office local / VPS env. Copy to `.env` (gitignored).
# Docker Compose interpolates this file for published (host) ports.

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_ROOM=office

# Host ports published by docker compose (container ports stay 7880/3000).
# Change these if 3000 or 7880 are taken. Keep LIVEKIT_PUBLIC_URL in sync
# with LIVEKIT_PORT (local). On the VPS, NPM forwards to these host ports.
LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_UDP_PORT=7882
NETPLAY_PORT=3000

# ROMs you have the right to host. Nothing commercial is in git.
# Nest cwd is `server/`, so `data/roms` → server/data/roms/
GAMES_ROM_DIR=data/roms

# Browser-facing EmulatorJS Netplay (Socket.IO).
# Empty locally → iframe uses http(s)://<hostname>:<NETPLAY_PORT>
# VPS: https://netplay.exemplo.com (NPM → host NETPLAY_PORT)
NETPLAY_PUBLIC_URL=

# Optional TURN. Default is Google STUN only.
# NETPLAY_ICE_JSON=[{"urls":"stun:stun.l.google.com:19302"}]

# EmulatorJS data CDN. Use latest (tracks main). There is no /main/ path on the CDN.
EJS_CDN=https://cdn.emulatorjs.org/latest/data/
